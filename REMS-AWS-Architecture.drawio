geometry"/></mxCell><mxCell id="p3-ss" value="&lt;b&gt;Static stability:&lt;/b&gt; one NAT gateway and one set of endpoints per AZ, so losing an AZ needs no control-plane change. Dev uses a single NAT to save cost." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="p3-1"><mxGeometry x="30" y="945" width="1000" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. CI-CD &amp; GitOps"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="900" math="0" shadow="0"><root><mxCell id="p4-0"/><mxCell id="p4-1" parent="p4-0"/><mxCell id="p4-title" value="CI/CD and GitOps flow (trunk-based, promote by digest)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="p4-1"><mxGeometry x="30" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="p4-lane0" value="Branching – trunk-based" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;strokeColor=#5A6C86;fillColor=#FAFAFA;fontColor=#232F3E;dashed=0;fontSize=13;fontStyle=1;" vertex="1" parent="p4-1"><mxGeometry x="30" y="60" width="1580" height="110" as="geometry"/></mxCell><mxCell id="p4-br1" value="feat/* · fix/* · hotfix/*&lt;br&gt;(short-lived)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;" vertex="1" parent="p4-lane0"><mxGeometry x="30" y="40" width="180" height="50" as="geometry"/></mxCell><mxCell id="p4-br2" value="Squash PR&lt;br&gt;(CODEOWNERS review, checks)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;" verte