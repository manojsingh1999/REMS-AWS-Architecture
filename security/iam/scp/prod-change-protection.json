{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDestructiveActionsWithoutBreakGlass",
      "Effect": "Deny",
      "Action": [
        "eks:DeleteCluster",
        "eks:DeleteNodegroup",
        "rds:DeleteDBCluster",
        "rds:DeleteGlobalCluster",
        "rds:DeleteDBInstance",
        "rds:DeleteDBClusterSnapshot",
        "elasticache:DeleteReplicationGroup",
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey",
        "s3:DeleteBucket",
        "backup:DeleteBackupVault",
        "backup:DeleteRecoveryPoint",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/break-glass": "true"
        }
      }
    },
    {
      "Sid": "DenyMutatingCallsFromMcpAndAiRoles",
      "Effect": "Deny",
      "NotAction": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:Converse",
        "bedrock:ConverseStream",
        "bedrock:ApplyGuardrail",
        "secretsmanager:GetSecretValue",
        "kms:Decrypt",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "kms:GenerateDataKey",
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/rems-*-llm-gateway",
            "arn:aws:iam::*:role/rems-*-metadata-rca",
            "arn:aws:iam::*:role/rems-*-mcp-*"
          ]
        }
      }
    }
  ]
}
